# =============================================================================
# Autonomous SOC Triage Agent v2.0 — Environment Configuration
# Copy this file to .env and fill in your free-tier API keys.
# =============================================================================

# Single Database: PostgreSQL + pgvector
# Local Docker Compose default:
DATABASE_URL=postgresql+psycopg://soc_user:soc_pass@postgres:5432/soc_triage
# Free Cloud Postgres (Neon.com — pgvector supported out of the box):
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Single Free Key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Free Threat Intelligence API Keys
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OTX_API_KEY=your_otx_api_key_here

# Optional Runtime Settings
APP_ENV=production
LOG_LEVEL=INFO
PROMPT_VERSION=v2.0
PORT=7860
IOC_CACHE_TTL_HOURS=24
OTX_CONFIDENCE_THRESHOLD=0.60
MAX_INVESTIGATION_LOOPS=1
BATCH_WINDOW_MINUTES=5
